digraph SmartEggCircuit {
  graph [
    rankdir=LR,
    splines=polyline,
    bgcolor="white",
    pad=0.25,
    nodesep=0.35,
    ranksep=0.8,
    fontname="Arial",
    label="SmartEgg — Circuito de conexión para Arduino Uno R3",
    labelloc=t,
    fontsize=20
  ];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=9, penwidth=2, dir=none];

  pc [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#E8F0FE">
      <TR><TD><B>Computadora</B></TD></TR>
      <TR><TD PORT="usb">USB / Python / Serial Plotter</TD></TR>
    </TABLE>
  >];

  uno [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
      <TR><TD COLSPAN="2" BGCOLOR="#D6EAF8"><B>Arduino Uno R3</B><BR/>alimentado por USB</TD></TR>
      <TR><TD PORT="usb">USB</TD><TD>Serial 115200</TD></TR>
      <TR><TD PORT="d2">D2 / INT0</TD><TD>Palanca SPDT ON/OFF</TD></TR>
      <TR><TD PORT="d3">D3 / INT1</TD><TD>Puerta</TD></TR>
      <TR><TD PORT="d4">D4</TD><TD>DHT11 DATA</TD></TR>
      <TR><TD PORT="d5">D5</TD><TD>Relé calefacción</TD></TR>
      <TR><TD PORT="d6">D6</TD><TD>Relé CH2 ventilador 5 V</TD></TR>
      <TR><TD PORT="d7">D7</TD><TD>Buzzer</TD></TR>
      <TR><TD PORT="d8">D8</TD><TD>Servo</TD></TR>
      <TR><TD PORT="d9">D9</TD><TD>Espacio 1</TD></TR>
      <TR><TD PORT="d10">D10</TD><TD>Espacio 2</TD></TR>
      <TR><TD PORT="d11">D11</TD><TD>Espacio 3</TD></TR>
      <TR><TD PORT="d12">D12</TD><TD>Espacio 4</TD></TR>
      <TR><TD PORT="a4">A4 / SDA</TD><TD>LCD I2C</TD></TR>
      <TR><TD PORT="a5">A5 / SCL</TD><TD>LCD I2C</TD></TR>
      <TR><TD PORT="v5">5V</TD><TD>Sensores</TD></TR>
      <TR><TD PORT="gnd">GND</TD><TD>Tierra lógica común</TD></TR>
    </TABLE>
  >];

  subgraph cluster_sensors {
    label="Sensores e interfaz local";
    color="#5DADE2";
    style="rounded";

    dht [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="2" BGCOLOR="#D5F5E3"><B>DHT11</B></TD></TR>
        <TR><TD PORT="vcc">1 VCC</TD><TD>5V</TD></TR>
        <TR><TD PORT="data">2 DATA</TD><TD>D4</TD></TR>
        <TR><TD>3 NC</TD><TD>sin conectar</TD></TR>
        <TR><TD PORT="gnd">4 GND</TD><TD>GND</TD></TR>
      </TABLE>
    >];
    rdht [shape=box, style="rounded,filled", fillcolor="#FCF3CF", label="R1 10 kΩ\npull-up DHT"];

    lcd [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="2" BGCOLOR="#D5F5E3"><B>LCD 1602 I2C · 0x27</B></TD></TR>
        <TR><TD PORT="vcc">VCC</TD><TD>5V</TD></TR>
        <TR><TD PORT="gnd">GND</TD><TD>GND</TD></TR>
        <TR><TD PORT="sda">SDA</TD><TD>A4</TD></TR>
        <TR><TD PORT="scl">SCL</TD><TD>A5</TD></TR>
      </TABLE>
    >];

    button [shape=box, style="rounded,filled", fillcolor="#FDEBD0", label="Palanca SPDT ON/OFF\nCOM: D2 · lateral ON: GND\notro lateral: libre"];
    door [shape=box, style="rounded,filled", fillcolor="#FDEBD0", label="Final de carrera puerta\nCOM: D3 · NC: GND\npuerta abierta = LOW"];
    slot1 [shape=box, style="rounded,filled", fillcolor="#FDEBD0", label="Espacio 1\nCOM: D9 · NO: GND"];
    slot2 [shape=box, style="rounded,filled", fillcolor="#FDEBD0", label="Espacio 2\nCOM: D10 · NO: GND"];
    slot3 [shape=box, style="rounded,filled", fillcolor="#FDEBD0", label="Espacio 3\nCOM: D11 · NO: GND"];
    slot4 [shape=box, style="rounded,filled", fillcolor="#FDEBD0", label="Espacio 4\nCOM: D12 · NO: GND"];
  }

  subgraph cluster_logic_power {
    label="Actuadores y alimentación lógica de 5 V";
    color="#58D68D";
    style="rounded";

    psu5 [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="2" BGCOLOR="#D5F5E3"><B>Fuente regulada 5 V / 2 A</B></TD></TR>
        <TR><TD PORT="plus">+5V</TD><TD>actuadores</TD></TR>
        <TR><TD PORT="minus">GND</TD><TD>común con Arduino</TD></TR>
      </TABLE>
    >];

    relay [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="2" BGCOLOR="#D5F5E3"><B>Módulo relé 4 canales · 5 V</B><BR/>entradas activas en alto</TD></TR>
        <TR><TD PORT="vcc">VCC</TD><TD>+5V externa</TD></TR>
        <TR><TD PORT="gnd">GND</TD><TD>GND común</TD></TR>
        <TR><TD PORT="in1">IN1</TD><TD>D5 · calor</TD></TR>
        <TR><TD PORT="in2">IN2</TD><TD>D6 · ventilador</TD></TR>
        <TR><TD PORT="in3">IN3</TD><TD>GND · apagado</TD></TR>
        <TR><TD PORT="in4">IN4</TD><TD>GND · apagado</TD></TR>
        <TR><TD PORT="com1">COM1</TD><TD>fase 110V con fusible</TD></TR>
        <TR><TD PORT="no1">NO1</TD><TD>bombilla</TD></TR>
        <TR><TD PORT="com2">COM2</TD><TD>+5V externa</TD></TR>
        <TR><TD PORT="no2">NO2</TD><TD>positivo ventilador</TD></TR>
        <TR><TD>CH3 / CH4</TD><TD>contactos sin conectar</TD></TR>
      </TABLE>
    >];

    servo [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="2" BGCOLOR="#D5F5E3"><B>Servo 5 V</B></TD></TR>
        <TR><TD PORT="sig">Señal</TD><TD>D8</TD></TR>
        <TR><TD PORT="vcc">Rojo</TD><TD>+5V externa</TD></TR>
        <TR><TD PORT="gnd">Café/negro</TD><TD>GND común</TD></TR>
      </TABLE>
    >];
    cap [shape=box, style="rounded,filled", fillcolor="#FCF3CF", label="C1 470 µF\n≥ 10 V\ncerca del servo"];

    rb [shape=box, style="rounded,filled", fillcolor="#FCF3CF", label="R2 1 kΩ"];
    rpd [shape=box, style="rounded,filled", fillcolor="#FCF3CF", label="R3 10 kΩ\npull-down"];
    q1 [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="2" BGCOLOR="#D5F5E3"><B>Q1 2N2222 NPN</B></TD></TR>
        <TR><TD PORT="b">B</TD><TD>base</TD></TR>
        <TR><TD PORT="c">C</TD><TD>colector</TD></TR>
        <TR><TD PORT="e">E</TD><TD>emisor</TD></TR>
      </TABLE>
    >];
    buzzer [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="2" BGCOLOR="#D5F5E3"><B>Buzzer activo 5 V</B></TD></TR>
        <TR><TD PORT="plus">+</TD><TD>+5V externa</TD></TR>
        <TR><TD PORT="minus">−</TD><TD>colector Q1</TD></TR>
      </TABLE>
    >];
    diode [shape=box, style="rounded,filled", fillcolor="#FCF3CF", label="D1 1N4007\nprotección\ncátodo a +5V"];

    fan [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="2" BGCOLOR="#D6EAF8"><B>Ventilador 5 V DC</B></TD></TR>
        <TR><TD PORT="plus">Rojo +</TD><TD>NO2</TD></TR>
        <TR><TD PORT="minus">Negro −</TD><TD>GND fuente 5V</TD></TR>
      </TABLE>
    >];
    diodeFan [shape=box, style="rounded,filled", fillcolor="#FCF3CF", label="D2 1N4007\nprotección\nbanda a +5V"];
  }

  subgraph cluster_loads {
    label="PELIGRO: potencia 110 V AC aislada y encerrada";
    color="#EC7063";
    style="rounded";

    mains [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="2" BGCOLOR="#FADBD8"><B>Red 110 V AC</B><BR/>sólo instalación calificada</TD></TR>
        <TR><TD PORT="line">FASE</TD><TD>con fusible</TD></TR>
        <TR><TD PORT="neutral">NEUTRO</TD><TD>no unir a GND lógico</TD></TR>
      </TABLE>
    >];
    f1 [shape=box, style="rounded,filled", fillcolor="#FADBD8", label="F1\nsegún bombilla"];
    lamp [shape=box, style="rounded,filled", fillcolor="#FCF3CF", label="Bombilla 110 V\nportalámparas cerrado"];
  }

  pc:usb -> uno:usb [color="#5B2C6F", label=" cable USB A–B "];

  uno:v5 -> dht:vcc [color="#C0392B", label="5V"];
  uno:v5 -> lcd:vcc [color="#C0392B"];
  uno:v5 -> rdht [color="#C0392B"];
  rdht -> dht:data [color="#C0392B"];
  uno:d4 -> dht:data [color="#2471A3", label="DATA"];
  uno:a4 -> lcd:sda [color="#7D3C98", label="SDA"];
  uno:a5 -> lcd:scl [color="#7D3C98", label="SCL"];

  uno:d2 -> button [color="#2471A3"];
  uno:d3 -> door [color="#2471A3"];
  uno:d9 -> slot1 [color="#2471A3"];
  uno:d10 -> slot2 [color="#2471A3"];
  uno:d11 -> slot3 [color="#2471A3"];
  uno:d12 -> slot4 [color="#2471A3"];

  uno:gnd -> dht:gnd [color="#17202A"];
  uno:gnd -> lcd:gnd [color="#17202A"];
  uno:gnd -> button [color="#17202A", label="GND"];
  uno:gnd -> door [color="#17202A"];
  uno:gnd -> slot1 [color="#17202A"];
  uno:gnd -> slot2 [color="#17202A"];
  uno:gnd -> slot3 [color="#17202A"];
  uno:gnd -> slot4 [color="#17202A"];

  uno:d5 -> relay:in1 [color="#2471A3", label="HIGH = ON"];
  uno:d6 -> relay:in2 [color="#2471A3", label="HIGH = ON"];
  diodeFan -> fan:plus [color="#17202A"];
  diodeFan -> fan:minus [color="#17202A"];
  uno:d8 -> servo:sig [color="#2471A3"];
  uno:d7 -> rb [color="#2471A3"];
  rb -> q1:b [color="#2471A3"];
  q1:b -> rpd [color="#17202A"];
  rpd -> psu5:minus [color="#17202A"];
  q1:c -> buzzer:minus [color="#17202A"];
  q1:e -> psu5:minus [color="#17202A"];
  diode -> buzzer:plus [color="#17202A"];
  diode -> buzzer:minus [color="#17202A"];

  psu5:plus -> relay:vcc [color="#C0392B", label="+5V externa"];
  psu5:plus -> servo:vcc [color="#C0392B"];
  psu5:plus -> buzzer:plus [color="#C0392B"];
  psu5:plus -> relay:com2 [color="#C0392B", label="+5V ventilador"];
  relay:no2 -> fan:plus [color="#C0392B"];
  fan:minus -> psu5:minus [color="#17202A"];
  psu5:plus -> cap [color="#C0392B"];
  psu5:minus -> relay:gnd [color="#17202A", label="GND común"];
  psu5:minus -> relay:in3 [color="#17202A", label="canal 3 OFF"];
  psu5:minus -> relay:in4 [color="#17202A", label="canal 4 OFF"];
  psu5:minus -> servo:gnd [color="#17202A"];
  psu5:minus -> cap [color="#17202A"];
  psu5:minus -> uno:gnd [color="#17202A", penwidth=3, label="unir tierras"];

  mains:line -> f1 [color="#D35400", label="FASE 110V"];
  f1 -> relay:com1 [color="#D35400"];
  relay:no1 -> lamp [color="#D35400"];
  lamp -> mains:neutral [color="#2C3E50", label="NEUTRO"];
}
