# Copiar este archivo como .env y ajustar los valores.

# --- Servidor ---
PUERTO=4000
# Deja vacío para escuchar en todas las interfaces (necesario para entrar desde
# el celular por la red local, requisito de la rúbrica 5.3)
HOST=0.0.0.0

# --- Puerto serial del Arduino ---
# Windows: COM3, COM4...   Linux: /dev/ttyACM0   macOS: /dev/cu.usbmodem14101
# Si se deja en AUTO el backend intenta detectar la placa automáticamente.
SERIAL_PUERTO=AUTO
SERIAL_BAUDIOS=115200

# Poner en 1 para trabajar sin Arduino (genera datos simulados).
# También se puede activar con: npm run sim
SIMULAR=0

# --- Base de datos ---
DB_ARCHIVO=./data/smartegg.db

# Cada cuántos milisegundos se guarda una lectura en la base de datos.
# El Arduino envía 1 trama por segundo; guardarlas todas llenaría la BD.
GUARDAR_CADA_MS=5000

# --- CORS ---
# Orígenes permitidos separados por coma. * permite todos (cómodo en desarrollo).
CORS_ORIGEN=*
