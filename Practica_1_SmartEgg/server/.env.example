SMARTEGG_DATABASE_URL=sqlite:///./data/smartegg.db
SMARTEGG_JWT_SECRET=replace-with-a-random-secret
SMARTEGG_CORS_ORIGINS=["http://localhost:3000"]
SMARTEGG_TIMEZONE=America/Guatemala

SMARTEGG_SERIAL_ENABLED=false
SMARTEGG_SERIAL_PORT=/dev/ttyACM0
SMARTEGG_SERIAL_BAUDRATE=115200
SMARTEGG_SERIAL_TIMEOUT_SECONDS=1.0
SMARTEGG_SERIAL_RECONNECT_SECONDS=3.0
SMARTEGG_DEFAULT_INCUBATOR_CODE=NODE-01

# Optional PNG/JPEG path used in the generated PDF.
SMARTEGG_REPORT_LOGO_PATH=
