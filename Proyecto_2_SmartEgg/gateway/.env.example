# Copiar a gateway/.env y ajustar. gateway/.env no se versiona.
# Ruta estable del adaptador USB de la ESP32 (ls /dev/serial/by-id/).
GATEWAY_SERIAL_PORT=/dev/ttyUSB0
GATEWAY_BAUDRATE=115200
NODE_CODE=NODE-01

# Broker: IP pública de la EC2, o localhost para pruebas locales.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=smartegg-gateway
MQTT_PASSWORD=replace-with-the-gateway-password
MQTT_TLS=false

# Cámara de la bandeja para el servicio de visión (vacío = sin cámara).
# Celular con IP Webcam por USB: adb forward tcp:8080 tcp:8080
CAMERA_URL=http://127.0.0.1:8080/shot.jpg
CAMERA_INTERVAL_SECONDS=1.0
