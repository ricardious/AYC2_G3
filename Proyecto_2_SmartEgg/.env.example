POSTGRES_DB=smartegg
POSTGRES_USER=smartegg
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432
# Opcional: si está definida, FastAPI usa esta PostgreSQL remota en lugar del
# contenedor local. Neon la genera con `neon env pull` e incluye SSL.
DATABASE_URL=

BACKEND_PORT=8000
JWT_SECRET=replace-with-a-random-secret
DEVICE_API_KEY=replace-with-a-random-device-key
KIOSK_API_KEY=replace-with-a-random-kiosk-key
ACCESS_SERVO_UNLOCK_DEGREES=90
ACCESS_SERVO_LOCK_DEGREES=0
CORS_ORIGINS=["http://localhost:3000"]
TIMEZONE=America/Guatemala
DEFAULT_INCUBATOR_CODE=NODE-01
MQTT_CLIENT_ID=smartegg-backend
INITIAL_TECHNICIANS=[]
INITIAL_INCUBATORS=[]
# gateway: la ESP32 llega por gateway/gateway.py (backend en la nube).
# serial: el backend abre el USB directamente (docker-compose.serial.yml).
NODE_TRANSPORT=gateway
SERIAL_DEVICE=/dev/ttyUSB0
SERIAL_BAUDRATE=115200

MQTT_PASSWORD=replace-with-a-strong-mqtt-password
MQTT_FRONTEND_PASSWORD=replace-with-a-different-frontend-password
MQTT_GRAFANA_PASSWORD=replace-with-a-different-grafana-password
MQTT_GATEWAY_PASSWORD=replace-with-a-different-gateway-password
MQTT_VISION_PASSWORD=replace-with-a-different-vision-password
MQTT_ML_PASSWORD=replace-with-a-different-ml-password
MQTT_PORT=1883
MQTT_WS_PORT=9001

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=replace-with-a-strong-read-only-password
# Para Neon: host, puerto y base de la URL no agrupada; use sslmode=require.
GRAFANA_POSTGRES_HOST=database
GRAFANA_POSTGRES_PORT=5432
GRAFANA_POSTGRES_DATABASE=smartegg
GRAFANA_POSTGRES_SSL_MODE=disable
GRAFANA_MQTT_URI=tcp://broker:1883
