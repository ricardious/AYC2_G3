          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(energy_wh) / NULLIF(EXTRACT(EPOCH FROM (max(recorded_at) - min(recorded_at))) / 3600, 0) AS \"Promedio\" FROM energy_samples WHERE incubator_id = $incubator_id AND recorded_at > now() - interval '1 hour'",
