# Optional. When omitted, the browser uses its current hostname on port 8000.
# This makes http://<IP_LOCAL>:3000 connect to http://<IP_LOCAL>:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional numeric id. When omitted, the first incubator returned by the API is used.
NEXT_PUBLIC_INCUBATOR_ID=1
NEXT_PUBLIC_INCUBATOR_CODE=NODE-01

# Debe coincidir con KIOSK_API_KEY del .env general.
NEXT_PUBLIC_ACCESS_KIOSK_KEY=replace-with-a-random-kiosk-key

# MQTT over WebSocket. Use wss:// when the frontend is served through HTTPS.
NEXT_PUBLIC_MQTT_URL=ws://localhost:9001
NEXT_PUBLIC_MQTT_USERNAME=smartegg-frontend
NEXT_PUBLIC_MQTT_PASSWORD=replace-with-a-different-frontend-password
