SMARTEGG_DATABASE_URL=postgresql+psycopg://smartegg:replace-with-a-strong-password@localhost:5432/smartegg
SMARTEGG_AUTO_CREATE_SCHEMA=false
SMARTEGG_JWT_SECRET=replace-with-a-random-secret
SMARTEGG_CORS_ORIGINS=["http://localhost:3000"]
SMARTEGG_TIMEZONE=America/Guatemala

# Optional accounts created at startup only when their username does not exist.
# Keep real passwords only in .env; never commit them.
SMARTEGG_INITIAL_TECHNICIANS=[]
# Example (remove the leading # and choose strong passwords):
# SMARTEGG_INITIAL_TECHNICIANS=[{"username":"ricardo","full_name":"Ricardo","age":25,"gender":"masculino","password":"change-this-password"}]

# Optional incubators created at startup only when their code does not exist.
SMARTEGG_INITIAL_INCUBATORS=[]
# Example:
# SMARTEGG_INITIAL_INCUBATORS=[{"code":"NODE-01","name":"Incubadora principal","capacity":4,"serial_number":"ARDUINO-UNO-R3"}]

SMARTEGG_SERIAL_ENABLED=false
SMARTEGG_SERIAL_PORT=/dev/ttyACM0
SMARTEGG_SERIAL_BAUDRATE=115200
SMARTEGG_SERIAL_TIMEOUT_SECONDS=1.0
SMARTEGG_SERIAL_RECONNECT_SECONDS=3.0
SMARTEGG_DEFAULT_INCUBATOR_CODE=NODE-01

# Optional PNG/JPEG path used in the generated PDF.
SMARTEGG_REPORT_LOGO_PATH=
